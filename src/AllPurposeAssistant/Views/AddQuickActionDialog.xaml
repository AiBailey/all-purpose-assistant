<Window x:Class="AllPurposeAssistant.Views.AddQuickActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Width="460" Height="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E6FFFFFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#8C5F86D9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Root" Property="Background" Value="#D9E2EEFF"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DialogComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                                    <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource TextSecondaryBrush}" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0"
                                        Background="#F2EEF3FF" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E6FFFFFF"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#99FFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#D9FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#BFE0E7FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#796784D8"/><Setter Property="BorderBrush" Value="#667A96ED"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border CornerRadius="20" ClipToBounds="True" BorderBrush="#99FFFFFF" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.22"/></Border.Effect>
            <Grid>
                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6DCEBFF" Offset="0"/><GradientStop Color="#E6EDE4FF" Offset="0.48"/><GradientStop Color="#E6D9F3EE" Offset="1"/></LinearGradientBrush></Grid.Background>
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.11" IsHitTestVisible="False"/>
                <Border Margin="16" Background="#DDF4F3FF" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="14">
                    <Grid Margin="24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DialogTitleText" Text="添加快捷操作" FontSize="20" FontWeight="SemiBold" FontFamily="Microsoft YaHei" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="DialogSubtitleText" Text="创建软件或常用网页的本地入口" FontSize="11" Margin="0,3,0,0" FontFamily="Microsoft YaHei" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Name="CloseButton" Grid.Column="1" Content="&#x00D7;" Width="28" Height="28" FontSize="18" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand"
                                    Foreground="{StaticResource TextSecondaryBrush}" ToolTip="关闭" Style="{StaticResource DialogButtonStyle}" Click="Close_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="名称" Margin="0,18,0,4" FontSize="12" FontFamily="Microsoft YaHei" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="2" x:Name="NameBox" Height="38" Style="{StaticResource DialogTextBoxStyle}"/>
                        <TextBlock Grid.Row="3" Text="快捷方式类型" Margin="0,12,0,4" FontSize="12" FontFamily="Microsoft YaHei" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Grid.Row="4" x:Name="ActionTypeCombo" Height="38" SelectedIndex="0" Style="{StaticResource DialogComboBoxStyle}" SelectionChanged="ActionType_SelectionChanged">
                            <ComboBoxItem Content="软件快捷打开" Tag="OpenApp"/>
                            <ComboBoxItem Content="网页快捷打开（使用 Edge）" Tag="OpenUrl"/>
                            <ComboBoxItem Content="文件夹快捷打开" Tag="OpenFolder"/>
                        </ComboBox>
                        <Grid Grid.Row="5" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="TargetLabel" Text="软件路径" FontSize="12" FontFamily="Microsoft YaHei" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TargetHint" Grid.Row="1" Text="可填 exe 路径，或点击右侧按钮选择文件" Margin="0,3,0,0" FontSize="10" FontFamily="Microsoft YaHei" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid Grid.Row="6" Margin="0,6,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TargetBox" Height="38" Style="{StaticResource DialogTextBoxStyle}"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Height="38" Margin="8,0,0,0" Style="{StaticResource DialogButtonStyle}" Click="Browse_Click"/>
                        </Grid>
                        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="取消" Width="76" Height="32" Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" Click="Cancel_Click"/>
                            <Button x:Name="ConfirmButton" Content="确定" Width="76" Height="32" Style="{StaticResource DialogPrimaryButtonStyle}" IsDefault="True" Click="Ok_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

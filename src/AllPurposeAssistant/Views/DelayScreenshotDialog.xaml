<Window x:Class="AllPurposeAssistant.Views.DelayScreenshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="延时截图" Width="300" Height="170" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="选择倒计时时长" FontSize="16" FontFamily="Microsoft YaHei"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button Content="3 秒后截图" Width="105" Height="38" Margin="0,0,12,0"
                    Click="ThreeSeconds_Click"/>
            <Button Content="5 秒后截图" Width="105" Height="38" Click="FiveSeconds_Click"/>
        </StackPanel>
    </Grid>
</Window>

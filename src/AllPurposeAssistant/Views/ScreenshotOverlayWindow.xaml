<Window x:Class="AllPurposeAssistant.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="RootCanvas">
            <!-- 四块蒙层：上、下、左、右，围住选区 -->
            <Rectangle x:Name="MaskTop" Fill="#88000000"/>
            <Rectangle x:Name="MaskBottom" Fill="#88000000"/>
            <Rectangle x:Name="MaskLeft" Fill="#88000000"/>
            <Rectangle x:Name="MaskRight" Fill="#88000000"/>
            <!-- 选区边框 -->
            <Rectangle x:Name="SelectionRect" Stroke="#4A90D9" StrokeThickness="2"
                       Fill="#204A90D9" Visibility="Collapsed"/>
            <!-- 提示文字 -->
            <TextBlock x:Name="HintText" Text="拖动选择截图区域，Esc 取消"
                       Foreground="White" FontSize="14" FontFamily="Microsoft YaHei"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Margin="16,12,0,0"/>
            <Border x:Name="Magnifier" Width="150" Height="178" Visibility="Collapsed"
                    Background="#EEFFFFFF" BorderBrush="#4A90D9" BorderThickness="2"
                    CornerRadius="8" IsHitTestVisible="False">
                <StackPanel Margin="6">
                    <Image x:Name="MagnifierImage" Width="134" Height="134"
                           Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="SelectionInfoText" Margin="0,5,0,0"
                               Foreground="#2C3E50" FontSize="11" FontFamily="Consolas"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>

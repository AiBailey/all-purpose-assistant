<Window x:Class="AllPurposeAssistant.Views.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Width="760" Height="620" MinWidth="500" MinHeight="400"
        PreviewKeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2" CornerRadius="10"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7F8C8D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2C3E50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="#DCE3EA" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Background="#F7F9FB" CornerRadius="12,12,0,0"
                    BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnPen" Style="{StaticResource ToolButton}" Content="&#x270F;"
                                      ToolTip="画笔" IsChecked="True" Click="Tool_Click" Tag="pen"/>
                        <ToggleButton x:Name="BtnRect" Style="{StaticResource ToolButton}" Content="&#9647;"
                                      ToolTip="方框" Click="Tool_Click" Tag="rect"/>
                        <ToggleButton x:Name="BtnArrow" Style="{StaticResource ToolButton}" Content="&#8599;"
                                      ToolTip="箭头" Click="Tool_Click" Tag="arrow"/>
                        <ToggleButton x:Name="BtnText" Style="{StaticResource ToolButton}" Content="T"
                                      ToolTip="文字" FontWeight="Bold" Click="Tool_Click" Tag="text"/>
                        <ToggleButton x:Name="BtnMosaic" Style="{StaticResource ToolButton}" Content="&#9638;"
                                      ToolTip="马赛克" Click="Tool_Click" Tag="mosaic"/>
                        <Separator Width="20" Margin="6,0"/>
                        <ToggleButton x:Name="ColorRed" Style="{StaticResource ColorButton}" Background="#E74C3C"
                                      ToolTip="红色" IsChecked="True" Click="Color_Click" Tag="#E74C3C"/>
                        <ToggleButton x:Name="ColorBlue" Style="{StaticResource ColorButton}" Background="#4A90D9"
                                      ToolTip="蓝色" Click="Color_Click" Tag="#4A90D9"/>
                        <ToggleButton x:Name="ColorOrange" Style="{StaticResource ColorButton}" Background="#F39C12"
                                      ToolTip="橙色" Click="Color_Click" Tag="#F39C12"/>
                        <ToggleButton x:Name="ColorGreen" Style="{StaticResource ColorButton}" Background="#27AE60"
                                      ToolTip="绿色" Click="Color_Click" Tag="#27AE60"/>
                        <ToggleButton x:Name="ColorBlack" Style="{StaticResource ColorButton}" Background="#2C3E50"
                                      ToolTip="黑色" Click="Color_Click" Tag="#2C3E50"/>
                        <Separator Width="20" Margin="6,0"/>
                        <ToggleButton Style="{StaticResource ToolButton}" Content="&#x21B6;"
                                ToolTip="撤销 (Ctrl+Z)" Click="Undo_Click" Foreground="#7F8C8D"/>
                        <ToggleButton Style="{StaticResource ToolButton}" Content="&#x21B7;"
                                ToolTip="重做 (Ctrl+Y)" Click="Redo_Click" Foreground="#7F8C8D"/>
                        <ToggleButton Style="{StaticResource ToolButton}" Content="&#128204;"
                                ToolTip="钉在桌面" Click="Pin_Click" Foreground="#E67E22"/>
                        <ToggleButton Style="{StaticResource ToolButton}" Content="&#128203;"
                                ToolTip="复制到剪贴板" Click="Copy_Click" Foreground="#27AE60"/>
                        <ToggleButton Style="{StaticResource ToolButton}" Content="&#128190;"
                                ToolTip="保存为文件" Click="Save_Click" Foreground="#4A90D9"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 画布 -->
            <Border Grid.Row="1" Background="#F0F2F5" CornerRadius="0,0,12,12"
                    ClipToBounds="True">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFF">
                    <Image x:Name="ShotImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="AnnotateCanvas" Background="Transparent"
                            Focusable="True"
                            MouseDown="AnnotateCanvas_MouseDown"
                            MouseMove="AnnotateCanvas_MouseMove"
                            MouseUp="AnnotateCanvas_MouseUp"/>
                </Grid>
            </Border>

            <!-- 状态条 -->
            <TextBlock x:Name="StatusBarText" Grid.Row="2"
                       Text="箭头主体可移动，拖动首尾可调整；文字框顶部边缘可移动，右下角可调整大小"
                       Foreground="#7F8C8D" FontSize="11" FontFamily="Microsoft YaHei"
                       Margin="12,6,0,0" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>

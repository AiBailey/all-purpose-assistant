<Window x:Class="AllPurposeAssistant.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="460"
        MinWidth="320" MinHeight="300"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NoteToolButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ResizeSurface" Background="#01000000"
          PreviewMouseLeftButtonDown="ResizeSurface_PreviewMouseLeftButtonDown"
          PreviewMouseMove="ResizeSurface_PreviewMouseMove"
          PreviewMouseLeftButtonUp="ResizeSurface_PreviewMouseLeftButtonUp">
        <Border x:Name="RootBorder" Margin="24" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="18"
                ClipToBounds="True" SizeChanged="RootBorder_SizeChanged">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.2"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6DCEBFF" Offset="0"/>
                    <GradientStop Color="#E6EDE4FF" Offset="0.48"/>
                    <GradientStop Color="#E6D9F3EE" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image x:Name="NoteBackgroundImage" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False"/>

                <Border Grid.Row="0"
                        Background="#DDEAF2FF" BorderBrush="#66FFFFFF" BorderThickness="0,0,0,1"
                        CornerRadius="17,17,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="10,0">
                        <TextBlock Text="便签"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Microsoft YaHei"
                                   VerticalAlignment="Center" Margin="0,0,64,0"/>
                        <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#x1F5BC;" Style="{StaticResource NoteToolButton}"
                                    Click="InsertImage_Click" ToolTip="插入图片"/>
                            <Button Content="&#x2716;" Style="{StaticResource NoteToolButton}"
                                    Click="Close_Click" ToolTip="关闭" Width="26"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#CFFFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1"
                        CornerRadius="0,0,17,17" Margin="12,8,12,12">
                    <RichTextBox x:Name="ContentBox"
                                 FontSize="14" FontFamily="Microsoft YaHei"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="4" Padding="10"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

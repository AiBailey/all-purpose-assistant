<Window x:Class="AllPurposeAssistant.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="64" Height="64"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource AppContextMenu}">
                <MenuItem Style="{StaticResource AppContextMenuItem}"
                          Header="切换到侧边栏" Click="SwitchToSidebar_Click"/>
                <MenuItem Style="{StaticResource AppContextMenuItem}"
                          Header="设置" Click="Settings_Click"/>
                <MenuItem Style="{StaticResource AppContextMenuItem}"
                          Header="最小化到托盘" Click="MinimizeToTray_Click"/>
                <Separator Style="{StaticResource AppContextMenuSeparator}"/>
                <MenuItem Style="{StaticResource AppContextMenuItem}"
                          Header="退出" Click="Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Ellipse x:Name="BallEllipse" Width="56" Height="56"
                 Stroke="Transparent" StrokeThickness="0">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#AB8DE0" Offset="0"/>
                    <GradientStop Color="#6687D6" Offset="0.5"/>
                    <GradientStop Color="#63B3BE" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="BallArtwork" Width="52" Height="52" Opacity="0.12" IsHitTestVisible="False"/>
        <TextBlock Text="帮" Foreground="White" FontSize="19" FontWeight="Bold"
                   FontFamily="Microsoft YaHei"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>

        <Popup x:Name="ActionPanel" PlacementTarget="{Binding ElementName=BallEllipse}"
               Placement="Right" AllowsTransparency="True"
               StaysOpen="False" IsOpen="False">
            <Border BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="14" Padding="8" Width="210">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0E7EEFF" Offset="0"/>
                        <GradientStop Color="#F0E5F4F0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <Button Style="{StaticResource SidebarButton}" Content="&#x1F4DD;  便签"
                            Click="NewNote_Click"/>
                    <Button Style="{StaticResource SidebarButton}" Content="&#x1F4F7;  截图"
                            Click="Screenshot_Click"/>
                    <Button Style="{StaticResource SidebarButton}" Content="&#x23F1;  延时截图"
                            Click="DelayedScreenshot_Click"/>
                    <Separator Margin="12,6"/>
                    <StackPanel x:Name="QuickActionsPanel"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

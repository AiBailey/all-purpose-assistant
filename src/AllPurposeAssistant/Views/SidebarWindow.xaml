<Window x:Class="AllPurposeAssistant.Views.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AllPurposeAssistant.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Width="340" Height="800" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ClipboardItemStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#CFF0F4FF"/>
            <Setter Property="BorderBrush" Value="#88FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#DDF4F3FF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="QuickActionRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33E85D75"/>
                                <Setter Property="Foreground" Value="#C33F5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#99FFFFFF"/>
                                <Setter Property="Foreground" Value="#5F6FD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ContentRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderToggle" Background="Transparent" BorderThickness="0" Padding="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="20" Height="20" CornerRadius="10" BorderBrush="#88909AB0" BorderThickness="1">
                                                <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="#66708090" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <RotateTransform CenterX="5" CenterY="2.5"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" CenterX="5" CenterY="2.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Grid.Row="1" Visibility="Collapsed"
                                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionEditButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3382A6E8"/>
                                <Setter Property="Foreground" Value="#4D69BC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="SidebarContextMenu" Style="{StaticResource AppContextMenu}">
            <MenuItem Style="{StaticResource AppContextMenuItem}" Header="切换到悬浮球" Click="SwitchToBall_Click"/>
            <MenuItem Style="{StaticResource AppContextMenuItem}" Header="设置" Click="Settings_Click"/>
            <MenuItem Style="{StaticResource AppContextMenuItem}" Header="最小化到托盘" Click="MinimizeToTray_Click"/>
            <Separator Style="{StaticResource AppContextMenuSeparator}"/>
            <MenuItem Style="{StaticResource AppContextMenuItem}" Header="退出" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="8">
        <Border BorderBrush="#99FFFFFF"
                BorderThickness="1" CornerRadius="18" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="0" Opacity="0.16"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E6DCEBFF" Offset="0"/>
                        <GradientStop Color="#E6EDE4FF" Offset="0.48"/>
                        <GradientStop Color="#E6D9F3EE" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False"/>

                <Border Grid.Row="0" BorderBrush="#66FFFFFF" BorderThickness="0,0,0,1"
                        CornerRadius="17,17,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border.Background>
                        <SolidColorBrush Color="#DDEAF2FF"/>
                    </Border.Background>
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="小帮手" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17" FontWeight="SemiBold" FontFamily="Microsoft YaHei"/>
                            <TextBlock Text="桌面效率助手" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" FontFamily="Microsoft YaHei" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="HeaderMenuButton" Grid.Column="1" Width="28" Height="28"
                                Content="&#x25BE;" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                Background="#33FFFFFF" BorderThickness="0" Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="更多操作" Click="HeaderMenu_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource SectionCardStyle}" Padding="8,10,8,8">
                            <StackPanel>
                                <TextBlock Text="日历" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontFamily="Microsoft YaHei" Margin="4,0,0,6"/>
                                <views:CalendarControl/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,10,0,0" Padding="8,10">
                            <StackPanel>
                                <TextBlock Text="常用功能" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontFamily="Microsoft YaHei" Margin="4,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <Button Style="{StaticResource SidebarButton}" Margin="2" Padding="4,0"
                                            HorizontalContentAlignment="Center" Content="✎ 便签" ToolTip="打开便签" Click="NewNote_Click"/>
                                    <Button Style="{StaticResource SidebarButton}" Margin="2" Padding="4,0"
                                            HorizontalContentAlignment="Center" Content="▣ 截图" ToolTip="立即截图" Click="Screenshot_Click"/>
                                    <Button Style="{StaticResource SidebarButton}" Margin="2" Padding="4,0"
                                            HorizontalContentAlignment="Center" Content="◷ 延时截图" ToolTip="延时截图" Click="DelayedScreenshot_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,10,0,0" Padding="8,10">
                            <StackPanel>
                                <Grid Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="快捷操作" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" FontFamily="Microsoft YaHei"/>
                                    <Button Grid.Column="1" Content="+" Style="{StaticResource QuickActionAddButtonStyle}"
                                            ToolTip="添加快捷操作" Click="AddQuickAction_Click"/>
                                </Grid>
                                <UniformGrid x:Name="QuickActionsGrid" Columns="2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,10,0,0" Padding="8,10">
                            <Expander x:Name="ClipboardExpander" IsExpanded="True"
                                      Style="{StaticResource ClipboardExpanderStyle}">
                                <Expander.Header>
                                    <Grid Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="剪贴板历史" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" FontFamily="Microsoft YaHei"/>
                                            <TextBlock x:Name="ClipboardCountText"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       FontFamily="Microsoft YaHei" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="ClearClipboardButton" Grid.Column="1"
                                                Content="🗑" FontSize="17" Width="22" Height="22"
                                                Style="{StaticResource QuickActionAddButtonStyle}"
                                                Cursor="Hand" ToolTip="清空剪贴板历史" Click="ClearClipboard_Click"/>
                                    </Grid>
                                </Expander.Header>
                                <ListBox x:Name="ClipboardList" Background="Transparent" BorderThickness="0"
                                         MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MouseLeftButtonUp="ClipboardItem_Click">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ClipboardItemStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Preview}" FontFamily="Microsoft YaHei" FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                               FontFamily="Microsoft YaHei" FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="AllPurposeAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="500" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E6FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8C5F86D9"/>
                                <Setter TargetName="Root" Property="Background" Value="#F2FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9E2EEFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#BFDCEBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"/>
                                    <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource TextSecondaryBrush}"
                                          Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0" Background="#F2EEF3FF" BorderBrush="#99FFFFFF"
                                        BorderThickness="1" CornerRadius="10" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="180" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E6FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8C5F86D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#99FFFFFF"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#BFE0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#796784D8"/>
            <Setter Property="BorderBrush" Value="#667A96ED"/>
        </Style>
        <Style x:Key="SettingsTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border CornerRadius="20" ClipToBounds="True" BorderBrush="#99FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.22"/>
            </Border.Effect>
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E6DCEBFF" Offset="0"/>
                        <GradientStop Color="#E6EDE4FF" Offset="0.48"/>
                        <GradientStop Color="#E6D9F3EE" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.11" IsHitTestVisible="False"/>
                <Border Margin="16" Background="#DDF4F3FF" BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="14">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Microsoft YaHei"/>
                                <TextBlock Text="所有设置仅保存在本机" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Microsoft YaHei"/>
                            </StackPanel>
                            <Button x:Name="SettingsCloseButton" Grid.Column="1" Content="&#x00D7;" Width="28" Height="28" FontSize="18"
                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                                    Background="#33FFFFFF" BorderThickness="0"
                                    Cursor="Hand" ToolTip="关闭" Click="Close_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="126"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="分类" FontSize="11" Margin="10,0,0,8"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Microsoft YaHei"/>
                                <Button x:Name="GeneralTabButton" Content="通用" Style="{StaticResource SettingsTabButtonStyle}"
                                        Background="#BFFFFFFF" Click="GeneralTab_Click"/>
                                <Button x:Name="ScreenshotTabButton" Content="截图" Margin="0,6,0,0"
                                        Style="{StaticResource SettingsTabButtonStyle}" Click="ScreenshotTab_Click"/>
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <StackPanel x:Name="GeneralSettingsPanel">
                                    <TextBlock Text="通用" FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei"/>
                                    <TextBlock Text="管理小帮手的启动方式与快捷入口" FontSize="11" Margin="0,4,0,18"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Microsoft YaHei"/>
                                    <Border Background="#99FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="启动与快捷方式" FontWeight="SemiBold" FontFamily="Microsoft YaHei"/>
                                                <TextBlock Text="创建桌面快捷方式，或设置登录 Windows 后自动启动。" FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Microsoft YaHei"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="配置…" Width="76" Height="32" VerticalAlignment="Center"
                                                    Style="{StaticResource SettingsButtonStyle}" Click="StartupSetup_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="ScreenshotSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="截图" FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei"/>
                                    <TextBlock Text="快捷键、保存格式与钉图显示方式" FontSize="11" Margin="0,4,0,18"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Microsoft YaHei"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="截图快捷键" VerticalAlignment="Center" FontFamily="Microsoft YaHei"/>
                                        <TextBox x:Name="HotKeyText" Grid.Column="1" Grid.ColumnSpan="2" Height="38" Padding="10,0"
                                                 Style="{StaticResource SettingsTextBoxStyle}" IsReadOnly="True" Cursor="Hand"
                                                 ToolTip="点击后直接按下新的快捷键组合"
                                                 GotKeyboardFocus="HotKeyText_GotKeyboardFocus" PreviewKeyDown="HotKeyText_PreviewKeyDown"/>
                                        <TextBlock Grid.Row="1" Text="默认保存目录" VerticalAlignment="Center" FontFamily="Microsoft YaHei"/>
                                        <TextBox x:Name="SaveDirectoryText" Grid.Row="1" Grid.Column="1" Height="38" Margin="0,12,0,0" Padding="10,0"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Height="38" Margin="8,12,0,0" Click="Browse_Click"
                                                Style="{StaticResource SettingsButtonStyle}"/>
                                        <TextBlock Grid.Row="2" Text="默认图片格式" VerticalAlignment="Center" Margin="0,12,0,0" FontFamily="Microsoft YaHei"/>
                                        <ComboBox x:Name="SaveFormatCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="38" Margin="0,12,0,0" SelectedIndex="0"
                                                  Style="{StaticResource SettingsComboBoxStyle}">
                                            <ComboBoxItem Content="PNG（无损）" Tag="Png"/>
                                            <ComboBoxItem Content="JPEG（较小文件）" Tag="Jpeg"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="3" Text="JPEG 质量" VerticalAlignment="Center" Margin="0,12,0,0" FontFamily="Microsoft YaHei"/>
                                        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="18"/><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="JpegQualityText" Grid.Column="0" Height="38" Padding="10,0"
                                                     Style="{StaticResource SettingsTextBoxStyle}"/>
                                            <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="钉图默认透明度" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="11" FontFamily="Microsoft YaHei"/>
                                            <ComboBox x:Name="PinnedOpacityCombo" Grid.Column="3" Height="38" Style="{StaticResource SettingsComboBoxStyle}">
                                                <ComboBoxItem Content="100%" Tag="1"/>
                                                <ComboBoxItem Content="80%" Tag="0.8"/>
                                                <ComboBoxItem Content="60%" Tag="0.6"/>
                                            </ComboBox>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Margin="100,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Microsoft YaHei"
                                               Text="设快捷键：点击后按下含 Ctrl / Alt / Shift 的组合键。"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="关闭" Width="76" Height="32" Margin="0,0,8,0" IsCancel="True"
                                        Style="{StaticResource SettingsButtonStyle}"/>
                                <Button x:Name="ScreenshotSaveButton" Content="保存" Width="76" Height="32" IsDefault="True" Click="Save_Click"
                                        Style="{StaticResource SettingsPrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
